# Copy this file to ".env" (same folder) and fill in your own keys. The real .env is never committed.

# Required for the live AI (Claude). Without it Sorty runs in practice mode with scripted answers.
ANTHROPIC_API_KEY=

# Optional: run the instant alert on Jev (TypeSafe AI's decision model). Without it the alert uses Claude Haiku.
JEV_API_KEY=

# Optional: run the careful brain on Google's Gemini through LangGraph (also set SORTY_PROVIDER=google).
GEMINI_API_KEY=

# Optional settings
# SORTY_BUDGET_USD=5            spending limit for AI calls; Sorty falls back to practice mode when it is reached
# SORTY_ORCHESTRATOR=langgraph  "langgraph" (default) or "classic"
# SORTY_GUARD=1                 0 switches the instant alert off
# SORTY_STATION=3bin            which bin layout and rules file to use (brain/rules/station_<name>.json)
